        <main class="content">
            <h2>Task 4: Analyze Temperature Readings Using Arrays</h2>
            <div id="resultsCard" class="sidebar-card" style="font-family: monospace; font-size: 1.1em; line-height: 1.8;"></div>
        </main>
    </div>

    <footer>
        <p>&copy; 2026 Disaster Management Agency</p>
    </footer>

    <script>
        let temperatureReadings = [34, 36, 38, 39, 41, 40, 37, 35, 39, 42];
        const threshold = 38;

        let minTemp = temperatureReadings[0];
        let maxTemp = temperatureReadings[0];
        let sum = 0;
        let countAboveThreshold = 0;
        let countGte40 = 0;
        let highHeatReadings = [];

        for (let i = 0; i < temperatureReadings.length; i++) {
            let temp = temperatureReadings[i];
            sum += temp;

            if (temp < minTemp) minTemp = temp;
            if (temp > maxTemp) maxTemp = temp;
            if (temp > threshold) countAboveThreshold++;
            if (temp >= 40) {
                countGte40++;
                highHeatReadings.push(temp);
            }
        }

        let avgTemp = (sum / temperatureReadings.length).toFixed(1);

        console.log("Readings: " + temperatureReadings.join(" "));
        console.log("Min: " + minTemp);
        console.log("Max: " + maxTemp);
        console.log("Avg: " + avgTemp);
        console.log("Readings >= 40: " + countGte40);

        document.getElementById('resultsCard').innerHTML = `
            <p><strong>Temperature Readings:</strong><br>${temperatureReadings.join(" ")}</p>
            <hr>
            <p><strong>Minimum Temperature:</strong> ${minTemp}&deg;C</p>
            <p><strong>Maximum Temperature:</strong> ${maxTemp}&deg;C</p>
            <p><strong>Average Temperature:</strong> ${avgTemp}&deg;C</p>
            <p><strong>Readings Above Threshold (&gt; ${threshold}&deg;C):</strong> ${countAboveThreshold}</p>
            <p><strong>Readings &ge; 40&deg;C:</strong> ${countGte40}</p>
            <p><strong>Heatwave Condition Readings:</strong> ${highHeatReadings.join(", ")}</p>
        `;
    </script>
</body>
</html>